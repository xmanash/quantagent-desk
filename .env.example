# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Vector DB
CHROMA_HOST=localhost
CHROMA_PORT=8002

# Risk engine defaults
DEFAULT_VAR_LIMIT=50000000
DEFAULT_ES_LIMIT=70000000
